<?xml version="1.0" encoding="UTF-8"?>
<CarrierConfiguration xmlns="http://www.rim.com/CarrierConfig/2012-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.rim.com/CarrierConfig/2012-01/CarrierConfiguration.xsd">
  <CarrierDataConfiguration version="1.0.0.0">
    <Name>Vodafone UA</Name>
    <Description>Configuration for Vodafone Ukraine data</Description>
    <CarrierID>255</CarrierID>
    <VendorID>01</VendorID>
    <PaymentProfileDeterminationType>UserManual</PaymentProfileDeterminationType>
    <PaymentProfileDefault>basic_service</PaymentProfileDefault>
    <ServiceConfiguration>
      <PaymentProfileFilter>basic_service</PaymentProfileFilter>
      <Name>internet</Name>
      <Description>Configuration for internet data</Description>
      <AlwaysOn>true</AlwaysOn>
      <LTEAttachService>true</LTEAttachService>
      <TCPKeepAlive></TCPKeepAlive>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>internet</APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfiguration>
      <Name>mms</Name>
      <Description>Configuration for mms data</Description>
      <AppModifiable>false</AppModifiable>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>mms</APN>
      </RadioAccessTechnology>
      <HttpProxyV4>10.10.10.10:8080</HttpProxyV4>
      <MMSC>http://mms.vodafone.ua/mmsc</MMSC>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfigurationAlias>
      <Name>a_gps</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_2</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_3</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_4</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>bip_5</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>blackberry</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_800</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>carrier_apps</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfiguration>
      <Name>ims</Name>
      <Description>Vodafone UA IMS VoLTE and VoWiFi configuration</Description>
      <Connectivity>
        <NotRoaming>AllowIfDataServicesEnabledOrVoLTECallActive</NotRoaming>
        <Roaming>AllowIfDataRoamingEnabledOrVoLTECallActive</Roaming>
      </Connectivity>
      <AlwaysOn>false</AlwaysOn>
      <NetworkInterfaceConfiguration>
        <IPConfiguration>
          <Type>IPv4v6</Type>
          <ProtectRouting>true</ProtectRouting>
          <DisableDAD>true</DisableDAD>
        </IPConfiguration>
      </NetworkInterfaceConfiguration>
      <BearerManagementTimer><KeepAlive>0</KeepAlive></BearerManagementTimer>
      <RadioAccessTechnology><APN>ims</APN></RadioAccessTechnology>
      <IMSConfiguration>
        <RequestPCSCFViaPCO>true</RequestPCSCFViaPCO>
        <RequestSignallingBearerViaPCO>true</RequestSignallingBearerViaPCO>
        <MediaConfiguration>
          <AudioCodecs>AMR-WB,AMR</AudioCodecs>
        </MediaConfiguration>
        <SIPConfiguration>
          <TimerT1>500</TimerT1>
          <TimerT2>4000</TimerT2>
          <TimerTF>32000</TimerTF>
        </SIPConfiguration>
      </IMSConfiguration>
      <EPDGConfiguration>
        <FQDN>epdg.epc.mnc001.mcc255.pub.3gppnetwork.org</FQDN>
        <AuthenticationMethod>EAP-AKA</AuthenticationMethod>
      </EPDGConfiguration>
    </ServiceConfiguration>
    <ServiceConfigurationAlias>
      <Name>lte_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>plan_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>rim_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>software_update</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>streaming</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>supplementary_services_admin</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_2</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_entitlement</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>tethering_user</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
    <ServiceConfigurationAlias>
      <Name>vvm</Name>
      <Reference>internet</Reference>
    </ServiceConfigurationAlias>
  </CarrierDataConfiguration>
  <CarrierECCConfiguration>
    <EccList>
      <EccNumber category="police">102</EccNumber>
      <EccNumber category="fire">101</EccNumber>
      <EccNumber category="ambulance">103</EccNumber>
      <EccNumber category="gas">104</EccNumber>
      <EccNumber>112</EccNumber>
      <EccNumber>911</EccNumber>
    </EccList>
  </CarrierECCConfiguration>
  <CarrierLanguageConfiguration>
    <ActivationLanguages extendedList="All" reducedList="uk_UA,en_US,en_GB" default="uk_UA"/>
  </CarrierLanguageConfiguration>
  <CarrierManagerConfiguration/>
  <CarrierAuthmanConfiguration/>
  <CarrierUIConfiguration>
    <ShowVoLTEIcon>true</ShowVoLTEIcon>
    <Show4GForLTE>true</Show4GForLTE>
    <AllowManualAPNEdit>true</AllowManualAPNEdit>
  </CarrierUIConfiguration>
</CarrierConfiguration>