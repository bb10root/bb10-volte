  <CarrierDataConfiguration version="1.0.0.0">
    <Name>China Mobile</Name>
    <Description>Configuration for China Mobile data</Description>
    <CarrierID>404</CarrierID>
    <VendorID>394</VendorID>
    <PaymentProfileDeterminationType>UserManual</PaymentProfileDeterminationType>
    <PaymentProfileDefault>basic_service</PaymentProfileDefault>
    <ServiceConfiguration>
      <PaymentProfileFilter>basic_service</PaymentProfileFilter>
      <Name>internet</Name>
      <Description>Configuration for internet data</Description>
      <AlwaysOn>true</AlwaysOn>
      <LTEAttachService>true</LTEAttachService>
      <TCPKeepAlive></TCPKeepAlive>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>cmnet</APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfiguration>
      <PaymentProfileFilter>enhanced_service</PaymentProfileFilter>
      <Name>internet</Name>
      <Description>Configuration for internet data</Description>
      <AlwaysOn>true</AlwaysOn>
      <AppModifiable>false</AppModifiable>
      <LTEAttachService>true</LTEAttachService>
      <TCPKeepAlive></TCPKeepAlive>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>cmwap</APN>
      </RadioAccessTechnology>
      <HttpProxyV4>10.0.0.172:80</HttpProxyV4>
      <EPDGConfiguration/>
    </ServiceConfiguration>
    <ServiceConfiguration>
      <Name>mms</Name>
      <Description>Configuration for mms data</Description>
      <AppModifiable>false</AppModifiable>
      <BearerManagementTimer/>
      <RadioAccessTechnology>
        <APN>cmwap</APN>
      </RadioAccessTechnology>
      <EPDGConfiguration/>
